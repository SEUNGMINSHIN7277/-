        "corner": "bottom_right"
      }
    },
    "lines": [
      {
        "speaker": "B",
        "tts": "아빠~ 나 부탁이 있는데.",
        "en": "Daddy~ I have a favow.",
        "emote": "shy"
      },
      {
        "speaker": "A",
        "tts": "어 뭔데, 우리 딸.",
        "en": "Sure, what is it sweetie."
      },
      {
        "speaker": "B",
        "tts": "용돈 천원만 올려주면 안 돼?",
        "en": "Can you waise my allowance by 1,000?"
      },
      {
        "speaker": "A",
        "tts": "천원? 왜?",
        "en": "1,000? Why?"
      },
      {
        "speaker": "B",
        "tts": "친구들은 다 오천원이야.",
        "en": "All my fwiends get 5,000."
      },
      {
        "speaker": "A",
        "tts": "오천원?! 아빠 어릴 땐 오백원이었어.",
