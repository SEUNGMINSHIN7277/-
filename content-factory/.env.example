# Copy to .env and fill in. Never commit .env.
#
# 💸 ZERO-COST DEFAULTS: tts_provider=edge needs NOTHING here, and
#    llm_provider=gemini uses a FREE key (no credit card) from
#    https://aistudio.google.com/apikey . With no keys at all it still runs
#    using the offline placeholder voice + the seed script library.

# ---- Script generation ----
# FREE: Google AI Studio key (no card). LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Paid alternative (LLM_PROVIDER=anthropic):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# ---- Korean TTS ----
# FREE default (TTS_PROVIDER=edge) needs NO key — uses Microsoft Edge voices.
# Override a role's free voice with VOICE_EDGE_<ROLE>=ko-KR-...Neural
# VOICE_EDGE_LITTLE_GIRL=ko-KR-SeoHyeonNeural

# ---- Paid TTS upgrades (optional) ----

# ElevenLabs (best Korean naturalness + voice variety). Map a Korean-capable
# voice id per role, e.g. VOICE_ELEVEN_LITTLE_GIRL=<voiceId>.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# VOICE_ELEVEN_LITTLE_GIRL=
# VOICE_ELEVEN_DAD=
# VOICE_ELEVEN_GRANDMA=

# Azure Speech (cheap, SSML pitch -> easy cute child voice). Defaults already
# map ko-KR neural voices + per-role pitch; override with VOICE_AZURE_<ROLE>.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral

# Google Cloud TTS (ko-KR Wavenet/Neural2 + pitch).
GOOGLE_TTS_API_KEY=

# ---- Optional background music (ducked under the voices) ----
# MUSIC_PATH=assets/music/bed.mp3

# ---- Optional: word-level caption timing from the real audio ----
# USE_WHISPER=1
# WHISPER_MODEL=base

# ---- YouTube publishing (PUBLISH_PROVIDER=youtube) ----
# YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
# YOUTUBE_TOKEN=secrets/token.json
# YOUTUBE_PRIVACY=private
