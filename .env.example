# shorts_agent 환경설정 예시. 실제 운영 시 .env 로 복사해 값을 채우세요.
# (이 파일에는 절대 실제 키를 넣지 마세요. .env 는 .gitignore 로 제외됨)

# ===== 운영 모드 =====
# DRY_RUN=true 면 키 없이 mock 으로 전 과정 시연(.mp4 산출).
# 핵심 키(ANTHROPIC/COUPANG)가 모두 있으면 자동으로 false 가 기본.
DRY_RUN=true
# AUTO=true 면 사람 게이트 없이 무인 발행(정책 리스크↑, 권장 안 함). 기본 false.
AUTO=false

DAILY_CAP=5                 # 전략적 발행 캡(YouTube API 한계 아님; 명세 0-2 참고)
TARGET_AUDIENCE=20-30대 여성
CHANNEL_NAME=오늘의픽
YOUTUBE_PRIVACY=private     # private|unlisted|public — 초기엔 private 로 검수 권장

# 공정위 표시문구(제목/첫부분/인트로 자막에 자동 삽입). 모호·조건부 표현 금지.
DISCLOSURE_TEXT=쿠팡파트너스 활동으로 일정액의 수수료를 제공받습니다

# ===== 쿠팡 파트너스 (모듈 A) =====
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=            # 채널/매체 식별용 subId(선택)

# ===== 대본 LLM (모듈 B) =====
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6   # 품질 우선 시 claude-opus-4-8

# ===== TTS (모듈 D) =====
TTS_PROVIDER=elevenlabs       # elevenlabs | clova | typecast (한국어는 clova/typecast 비교 추천)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=          # 채널 페르소나 고정(한 목소리 유지 권장)
ELEVENLABS_MODEL=eleven_multilingual_v2
# Naver CLOVA Voice (NCP)
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=
CLOVA_SPEAKER=nara            # nara/vyuna 등 화자
# Typecast
TYPECAST_API_KEY=
TYPECAST_ACTOR_ID=

# ===== 스톡 보조 컷 (모듈 C) =====
PEXELS_API_KEY=

# ===== YouTube 업로드 (모듈 G) =====
# OAuth: client secret 으로 최초 1회 인증해 token(json) 발급 후 경로 지정.
#   python -m shorts_agent.auth_youtube client_secret.json youtube_token.json
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_TOKEN_FILE=
# 피드백 루프(자기 채널 Analytics 읽기 토큰). 없으면 output/performance.json 사용.
YOUTUBE_ANALYTICS_TOKEN_FILE=

# ===== 경로(보통 기본값 사용) =====
# OUTPUT_DIR=output
# FONT_PATH=assets/fonts/NanumGothic.ttf
# 배경음악: 이 폴더에 라이선스 안전 음원(mp3/m4a/wav)을 넣으면 영상별로 자동 선택·덕킹.
# MUSIC_DIR=assets/music
